# Copy to .env.local and fill in. Never commit .env.local.

# --- Member 4 backend: Supabase (accounts, roadmap, documents vault, bookings, applications)
# The URL and PUBLISHABLE key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY (never NEXT_PUBLIC_, never in code): the Supabase secret key. Used only to open the account
# linked to a verified SANAD identity (Login with SANAD) and to link a SANAD identity to a new account.
SUPABASE_SECRET_KEY=

# --- Published websites (Launch Studio). Sites are served at /s/<name> and at <name>.localhost locally.
# Set this to a wildcard domain pointed at the app to serve <name>.<domain> in production.
BEDAYA_SITE_DOMAIN=

# --- AI (Member 5). Every feature works without a model; a model makes the chatbot conversational.
# LLM_PROVIDER:
#   mock       offline answers from Bedaya's data (no model, no key)
#   ollama     free open-source model on this computer (install Ollama, then: ollama pull qwen2.5:7b)
#   anthropic  Claude via the Anthropic API (paid; needs LLM_API_KEY and BEDAYA_ALLOW_EXTERNAL_AI=true)
LLM_PROVIDER=mock
LLM_API_KEY=
# Defaults: qwen2.5:7b for ollama, claude-opus-5 for anthropic
LLM_MODEL=
# Ollama address (local by default; a non-local address also needs BEDAYA_ALLOW_EXTERNAL_AI=true)
OLLAMA_URL=http://127.0.0.1:11434
# Features that use the model, comma separated, or * for all. Default with ollama: chat,studio_names,studio_tone
# (long outputs such as logos and full websites stay on the instant offline generators).
LLM_TASKS=
# Time limits in ms: LLM_TIMEOUT_MS for anthropic (default 8000), OLLAMA_TIMEOUT_MS for the local model
# (default 60000; the first answer includes loading the model onto the GPU)
LLM_TIMEOUT_MS=
OLLAMA_TIMEOUT_MS=
# low | medium | high
LLM_EFFORT=low
# Set to off to ignore lib/integrations/demo-cache.json
DEMO_CACHE=on
# M4 safety switch: external AI calls happen only when this is true.
BEDAYA_ALLOW_EXTERNAL_AI=false

# --- Member 5 identity, documents and signing (Abdullah)
# OCR_PROVIDER: mock | tesseract | cloud
OCR_PROVIDER=mock
OCR_API_KEY=
# SANAD_MODE: mock (default) | real (after MoDEE approves; not built yet)
SANAD_MODE=mock
# Where M5 keeps its demo data. Default: .data/ (on Vercel: /tmp)
BEDAYA_DATA_DIR=
