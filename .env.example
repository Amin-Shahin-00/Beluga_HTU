# Copy to .env.local and fill in. Never commit .env.local.

# --- Member 4 backend: Supabase (accounts, roadmap, documents vault, bookings, applications)
# The URL and PUBLISHABLE key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY (never NEXT_PUBLIC_, never in code): the Supabase secret key. Used only to open the account
# linked to a verified SANAD identity (Login with SANAD) and to link a SANAD identity to a new account.
SUPABASE_SECRET_KEY=

# --- Published websites (Launch Studio). Sites are served at /s/<name> and at <name>.localhost locally.
# Set this to a wildcard domain pointed at the app to serve <name>.<domain> in production.
BEDAYA_SITE_DOMAIN=

# --- Member 5 AI (Ameen). Mock mode needs no key and answers from Bedaya's data.
# LLM_PROVIDER: mock | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
# Defaults to claude-opus-5
LLM_MODEL=
LLM_TIMEOUT_MS=8000
# low | medium | high
LLM_EFFORT=low
# Set to off to ignore lib/integrations/demo-cache.json
DEMO_CACHE=on
# M4 safety switch: external AI calls happen only when this is true.
BEDAYA_ALLOW_EXTERNAL_AI=false

# --- Member 5 identity, documents and signing (Abdullah)
# OCR_PROVIDER: mock | tesseract | cloud
OCR_PROVIDER=mock
OCR_API_KEY=
# SANAD_MODE: mock (default) | real (after MoDEE approves; not built yet)
SANAD_MODE=mock
# Where M5 keeps its demo data. Default: .data/ (on Vercel: /tmp)
BEDAYA_DATA_DIR=
