# M5 integrations. One shared key for both M5 members; mock mode needs no key.
# LLM_PROVIDER: mock (no key, answers from Bedaya's data) | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
# Defaults to claude-opus-5
LLM_MODEL=
LLM_TIMEOUT_MS=8000
# low | medium | high
LLM_EFFORT=low
# Set to off to ignore lib/integrations/demo-cache.json
DEMO_CACHE=on
# OCR_PROVIDER: mock | tesseract | cloud (owned by the M5 partner)
OCR_PROVIDER=mock
OCR_API_KEY=
